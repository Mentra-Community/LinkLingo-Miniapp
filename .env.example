PORT=3240
PACKAGE_NAME=com.mentra.link
NODE_ENV=development

# Gemini (required in production)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# LLM_MODEL=gemini-3.5-flash-lite

# Mentra auth (JWKS from Cloud Core). The backend also tries prod + dev
# JWKS so a production Mentra App token works against the dev backend.
MENTRA_AUTH_JWKS_URL=https://core.mentraglass.com/.well-known/jwks.json
MENTRA_AUTH_ISSUERS=cloud-core,mentra

# Local-only escapes (never enable in prod)
LINKLINGO_ALLOW_MOCK_LLM=false
LINKLINGO_ALLOW_UNAUTH=false

# Observability. debug adds candidate selection and per-LLM-request lines.
# logfmt is human-readable; json is for a log collector.
LOG_LEVEL=info
LOG_FORMAT=logfmt

# Baked into the phone bundle (public)
MENTRA_PUBLIC_LINKLINGO_BACKEND_URL=http://localhost:3240
# Background log verbosity on the phone: debug|info|warn|error|silent
MENTRA_PUBLIC_LINKLINGO_LOG_LEVEL=info
