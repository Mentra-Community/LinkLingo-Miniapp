PORT=3240
PACKAGE_NAME=com.mentra.link
NODE_ENV=development

# OpenRouter (required in production; unique key per environment)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-oss-120b
# Pin the upstream for the live path. Without it OpenRouter routes by price and
# the p95 more than doubles. Compare candidates with `bun run bench:models`.
OPENROUTER_PROVIDER=cerebras

# Mentra auth (JWKS from Cloud Core). The backend also tries prod + dev
# JWKS so a production Mentra App token works against the dev backend.
MENTRA_AUTH_JWKS_URL=https://core.mentraglass.com/.well-known/jwks.json
MENTRA_AUTH_ISSUERS=cloud-core,mentra

# Local-only escapes (never enable in prod)
LINKLINGO_ALLOW_MOCK_LLM=false
LINKLINGO_ALLOW_UNAUTH=false

# Review log: the last ~24h of model input/output, for prompt tuning.
# GET /api/review/entries is only served when a token is set (entries carry
# transcripts). `bun run review` reads it; LINKLINGO_REVIEW_FILE additionally
# appends every entry as JSONL on the backend host.
LINKLINGO_REVIEW_TOKEN=
# LINKLINGO_REVIEW_FILE=./backend/data/review.jsonl
# LINKLINGO_TRANSCRIPT_FILE=./backend/data/transcripts.jsonl
# LINKLINGO_FEEDBACK_FILE=./backend/data/feedback.jsonl
# Model behind "Ask the analyst" in the WebView (user-triggered, may take seconds)
# Unset = DEFAULT_ANALYST_MODEL in backend/src/services/openrouter.ts.
# OPENROUTER_ANALYST_MODEL=
# OPENROUTER_ANALYST_PROVIDER=anthropic
# S3 bucket that keeps transcripts, gloss calls, and analyst questions for 24h
# across pod evictions. Unset = memory only, wiped on restart.
# LINKLINGO_TAPE_BUCKET=porter-15081-linklingo-tape-fa86de16
# AWS_REGION=us-west-2
# LINKLINGO_REVIEW_RETENTION_HOURS=24
# LINKLINGO_REVIEW_MAX_ENTRIES=2000
# Where `bun run review` fetches from (defaults to the dev deployment)
# LINKLINGO_REVIEW_URL=https://linklingo-miniapp-dev.mentraglass.com

# Observability. debug adds candidate selection and per-LLM-request lines.
# logfmt is human-readable; json is for a log collector.
LOG_LEVEL=info
LOG_FORMAT=logfmt

# Baked into the phone bundle (public)
MENTRA_PUBLIC_LINKLINGO_BACKEND_URL=http://localhost:3240
# Background log verbosity on the phone: debug|info|warn|error|silent
MENTRA_PUBLIC_LINKLINGO_LOG_LEVEL=info
