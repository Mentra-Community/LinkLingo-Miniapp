PORT=3240
PACKAGE_NAME=com.mentra.link
NODE_ENV=development

# Gemini (required in production)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# LLM_MODEL=gemini-3.5-flash-lite

# Mentra auth (JWKS from Cloud Core)
MENTRA_AUTH_JWKS_URL=https://core.dev.us-west-2.mentraglass.com/.well-known/jwks.json
MENTRA_AUTH_ISSUERS=cloud-core,mentra

# Local-only escapes (never enable in prod)
LINKLINGO_ALLOW_MOCK_LLM=false
LINKLINGO_ALLOW_UNAUTH=false

# Baked into the phone bundle (public)
MENTRA_PUBLIC_LINKLINGO_BACKEND_URL=http://localhost:3240
